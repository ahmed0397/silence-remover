{
  "version": 2,
  "builds": [
    {
      "src": "{index.html,hero-banner.jpg,robots.txt,sitemap.xml,favicon.ico,favicon.png,favicon.svg,favicon-*.png,apple-touch-icon.png,public/**}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      },
      "continue": true
    },
    {
      "src": "/ffmpeg/(.*)",
      "dest": "/public/ffmpeg/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
